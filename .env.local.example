# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Privy ---
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# SERVER-ONLY. Used by lib/privy.ts to verify access tokens and look up users.
PRIVY_APP_SECRET=your-privy-app-secret

# --- WalletConnect ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# --- Contracts and RPC (Base Sepolia testnet) ---
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# SERVER-ONLY. Kept for server-side RPC callers and future operator actions.
RPC_URL=https://sepolia.base.org
OPERATOR_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
