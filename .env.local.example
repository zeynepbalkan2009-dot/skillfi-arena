# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Privy ---
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# SERVER-ONLY. Used by lib/privy.ts to verify access tokens and look up users.
PRIVY_APP_SECRET=your-privy-app-secret

# --- WalletConnect ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# --- Contracts and RPC ---
# Keep baseSepolia until an Arc deployment exists; then switch to arcTestnet
# and replace the escrow/token addresses with the Arc deployment values.
NEXT_PUBLIC_CHAIN_TARGET=baseSepolia
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_GNESS_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# SERVER-ONLY. Kept for server-side RPC callers and future operator actions.
RPC_URL=https://sepolia.base.org
OPERATOR_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Wallet granted OPERATOR_ROLE on the deployed SkillFiEscrowV2.
# NEVER expose this as NEXT_PUBLIC_ or commit the real key.
OPERATOR_PRIVATE_KEY=0xyour-server-only-private-key

# --- Studio onboarding fee ---
# Testnet/development default is 100 USDC when omitted. Set both explicitly in production.
STUDIO_LISTING_FEE_USDC=100
STUDIO_FEE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional comma-separated user UUIDs. The configured operator wallet is also an admin in development.
STUDIO_ADMIN_USER_IDS=
# Public contact used by the pilot-partner call to action.
NEXT_PUBLIC_CONTACT_EMAIL=
