# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Privy ---
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# SERVER-ONLY. Used to verify Privy access tokens and look up users.
PRIVY_APP_SECRET=your-privy-app-secret

# --- WalletConnect ---
# Hosted environments must use a real project ID; placeholders are rejected.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# --- Contracts and RPC ---
# Production promotion requires a validated SkillFiEscrowV3 deployment. Keep
# zero-address placeholders only for local/Preview build contexts that explicitly
# permit them; hosted production fails closed on placeholders.
NEXT_PUBLIC_CHAIN_TARGET=arcTestnet
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# SERVER-ONLY RPC/operator identity. The operator must be distinct from deployer,
# admin, arbiter, and treasury on SkillFiEscrowV3.
RPC_URL=https://rpc.testnet.arc.network
OPERATOR_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Wallet granted only the application OPERATOR_ROLE on the validated V3 deployment.
# NEVER expose this as NEXT_PUBLIC_ or commit a real key.
OPERATOR_PRIVATE_KEY=0xyour-server-only-v3-operator-private-key

# --- Value-bearing release switch ---
# FAIL-CLOSED. Leave unset or 0 during development, Preview, migrations, V3
# deployment, and production smoke testing. Set to exactly 1 only as the FINAL
# release step after every value-bearing gate in DEPLOYMENT_READINESS.md passes.
# Turning it off blocks NEW staked create/join preflight but intentionally does
# not block settlement, cancellation, disputes, or recovery for existing funds.
SKILLFI_VALUE_BEARING_ENABLED=0

# --- Studio onboarding fee ---
# Set both explicitly wherever studio listing fees are enabled. No operator-wallet
# fallback is permitted.
STUDIO_LISTING_FEE_USDC=
STUDIO_FEE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Explicit web-admin identities. Blockchain operator identity is not an admin source.
STUDIO_ADMIN_USER_IDS=
STUDIO_ADMIN_WALLET_ADDRESSES=

# Public contact used by the pilot-partner call to action.
NEXT_PUBLIC_CONTACT_EMAIL=

# Hosted production/Preview must NOT define test-auth fixtures:
# SKILLFI_TEST_PRIVY_TOKEN_MAP
# SKILLFI_TEST_PRIVY_USERS
