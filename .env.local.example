# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-ONLY — used by lib/supabaseAdmin.ts. Never
# prefix with NEXT_PUBLIC_, never import lib/supabaseAdmin.ts from a
# "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Privy ---
# From your Privy dashboard (Settings -> API Keys / Basics).
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# SERVER-ONLY — used by lib/privy.ts to verify access tokens and look up
# users. Never prefix with NEXT_PUBLIC_.
PRIVY_APP_SECRET=your-privy-app-secret

# --- Contracts (Base Sepolia testnet by default — see lib/contracts.ts) ---
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_GNESS_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# --- RPC (server-side only, used by the on-chain verification route) ---
# Optional. Falls back to Base Sepolia's default public endpoint if unset
# — fine for development, use a dedicated provider in production.
RPC_URL=
