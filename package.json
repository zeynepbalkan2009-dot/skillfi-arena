{
  "name": "skillfi-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:product": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node scripts/db-validation.mjs",
    "test:db:hosted": "powershell -NoProfile -Command \"$env:SKILLFI_DB_PROFILE='hosted'; node scripts/db-validation.mjs\"",
    "test:supabase": "node scripts/supabase-http-validation.mjs",
    "test:risk": "node scripts/risk-validation.mjs",
    "test:settlement": "node scripts/settlement-validation.mjs",
    "test:cancellation": "node scripts/cancellation-validation.mjs",
    "list:disputes": "node scripts/list-disputes.mjs",
    "test:studio": "node scripts/studio-validation.mjs",
    "resolve:dispute": "node scripts/resolve-dispute.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@privy-io/node": "^0.22.0",
    "@privy-io/react-auth": "^3.32.2",
    "@privy-io/wagmi": "^4.0.13",
