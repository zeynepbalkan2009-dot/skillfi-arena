  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "pg": "^8.22.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
